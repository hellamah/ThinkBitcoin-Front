{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ThinkBitcoin Front: Vite (dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/src"
    },
    {
      "name": "ThinkBitcoin Front: Abrir no Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/home",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true
    },
    {
      "name": "ThinkBitcoin Front: Testes (Vitest)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/src",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "test"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
